main {
  display: flex;
  flex-direction: column;
}

#upper_section {
  display: flex;
  flex-direction: column;
}

#upper_section header {
  display: flex;
  gap: 1.5vh;
}

#upper_section header article {
  flex: 1;
}

#upper_section p {
  display: inline;
}

#characteristics div {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  gap: 0.5vh;
}

#characteristics label {
  flex-shrink: 2;
  display: grid;
  grid-template-columns: max-content max-content max-content;
  grid-template-rows: auto auto;
  align-items: center;
  /* justify-content: center; */
}

#characteristics label p {
  grid-column: 1;
  grid-row: span 2;
}

#characteristics label input {
  grid-column: 2;
  grid-row: span 2;
  width: 25%;
}

#characteristics label span {
  grid-column: 3;
  grid-row: 1;
}

#characteristics label span:last-of-type {
  grid-column: 3;
  grid-row: 2;
}
